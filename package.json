{
  "name": "cypress_2",
  "version": "1.0.0",
  "description": "",
  "author": "Pavel Ryabikin",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "cy:main-page": "cypress run --browser chrome --spec cypress/e2e/tests1/main-page.cy.js --record --key b69fa027-548c-4e20-8b0e-e1a85e71a0f3",
    "cy:admin-login": "cypress run --browser chrome --spec cypress/e2e/tests2/admin-login.cy.js --record --key b69fa027-548c-4e20-8b0e-e1a85e71a0f3",
    "cy:booking": "cypress run --browser chrome --spec cypress/e2e/booking.cy.js --record --key b69fa027-548c-4e20-8b0e-e1a85e71a0f3",
    "cy:chrome": "cypress run --browser chrome --record --key b69fa027-548c-4e20-8b0e-e1a85e71a0f3",
    "cy:edge": "cypress run --browser edge --record --key b69fa027-548c-4e20-8b0e-e1a85e71a0f3",
    "cy:electron": "cypress run --browser electron --record --key b69fa027-548c-4e20-8b0e-e1a85e71a0f3",
    "cy:parallel": "start /b npm run cy:chrome & start /b npm run cy:edge",
    "cy:folder1": "cypress run --browser chrome --spec cypress/e2e/tests1/**/*.cy.js --record --key b69fa027-548c-4e20-8b0e-e1a85e71a0f3",
    "cy:folder2": "cypress run --browser edge --spec cypress/e2e/tests2/**/*.cy.js --record --key b69fa027-548c-4e20-8b0e-e1a85e71a0f3",
    "cy:folders-parallel": "start /b npm run cy:folder1 & start /b npm run cy:folder2"
  },
  "dependencies": {
    "cypress": "^16.0.0"
  }
}
